#cloud-config
autoinstall:
  version: 1
  locale: pt_BR.UTF-8
  keyboard:
    layout: br
    variant: ''
  early-commands:
    - |
      nmcli dev wifi connect "YOUR_WIFI_SSID_1" password "YOUR_WIFI_PASSWORD_1" 2>/dev/null || \
      nmcli dev wifi connect "YOUR_WIFI_SSID_2" password "YOUR_WIFI_PASSWORD_2" 2>/dev/null || true
      sleep 15
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
      - arches: [amd64]
        uri: http://br.archive.ubuntu.com/ubuntu
  storage:
    config:
      - type: disk
        id: disk0
        match:
          size: largest
        wipe: superblock-recursive
        ptable: gpt
      - type: partition
        id: part-efi
        device: disk0
        size: 512M
        flag: esp
        grub_device: true
      - type: partition
        id: part-boot
        device: disk0
        size: 1G
      - type: partition
        id: part-luks
        device: disk0
        size: -1
      - type: dm_crypt
        id: dm-crypt0
        volume: part-luks
        key: "YOUR_LUKS_PASSWORD_HERE"
      - type: lvm_volgroup
        id: vg0
        name: ubuntu-vg
        devices: [dm-crypt0]
      - type: lvm_partition
        id: lv-root
        volgroup: vg0
        name: ubuntu-lv
        size: -1
      - type: format
        id: format-root
        volume: lv-root
        fstype: ext4
      - type: mount
        id: mount-root
        device: format-root
        path: /
      - type: format
        id: format-efi
        volume: part-efi
        fstype: vfat
      - type: mount
        id: mount-efi
        device: format-efi
        path: /boot/efi
      - type: format
        id: format-boot
        volume: part-boot
        fstype: ext4
      - type: mount
        id: mount-boot
        device: format-boot
        path: /boot
  identity:
    hostname: ubuntu-temp
    username: tempuser
    password: "$6$REPLACE_WITH_PASSWORD_HASH"
  ssh:
    install-server: false
  updates: security
  late-commands:
    - |
      SERIAL=$(dmidecode -s system-serial-number | tr -d '[:space:]')
      echo "COMPANY${SERIAL}" > /target/etc/hostname
      sed -i "s/ubuntu-temp/COMPANY${SERIAL}/g" /target/etc/hosts
    - |
      cat > /target/etc/netplan/00-installer-config.yaml << 'EOF'
      network:
        version: 2
        ethernets:
          all-en:
            match:
              name: "en*"
            dhcp4: true
            optional: true
        wifis:
          all-wl:
            match:
              name: "wl*"
            dhcp4: true
            optional: true
            access-points:
              "YOUR_WIFI_SSID_1":
                password: "YOUR_WIFI_PASSWORD_1"
              "YOUR_WIFI_SSID_2":
                password: "YOUR_WIFI_PASSWORD_2"
      EOF
    - chmod 600 /target/etc/netplan/00-installer-config.yaml
    - |
      cat > /target/etc/systemd/system/fit-firstboot.service << 'EOF'
      [Unit]
      Description=First Boot Configuration
      After=network-online.target plymouth-quit.service
      Wants=network-online.target
      ConditionPathExists=!/var/lib/fit-firstboot-done
      DefaultDependencies=no
      [Service]
      Type=simple
      ExecStart=/bin/bash /opt/fit-scripts/fit-firstboot.sh
      StandardOutput=journal
      StandardError=journal
      TimeoutStartSec=0
      [Install]
      WantedBy=multi-user.target
      EOF
    - |
      cat > /target/etc/systemd/system/fit-firstboot.timer << 'EOF'
      [Unit]
      Description=First Boot Configuration Timer
      [Timer]
      OnBootSec=120s
      Unit=fit-firstboot.service
      [Install]
      WantedBy=timers.target
      EOF
    - mkdir -p /target/etc/systemd/system/timers.target.wants
    - ln -sf /target/etc/systemd/system/fit-firstboot.timer /target/etc/systemd/system/timers.target.wants/fit-firstboot.timer
  shutdown: reboot
